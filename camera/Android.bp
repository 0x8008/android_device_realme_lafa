soong_namespace {
    imports: ["hardware/oplus"],
}

java_library {
    name: "lafa-camera-compat",
    system_ext_specific: true,
    installable: true,
    srcs: ["compat/src/**/*.java", "compat/src/**/*.aidl"],
    libs: ["oplus-fwk"],
    aidl: { local_include_dirs: ["compat/src"] },
}

android_app_import {
    name: "OplusCamera",
    apk: "proprietary/OplusCamera.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    enforce_uses_libs: false,
    dex_preopt: { enabled: false },
}

dex_import {
    name: "com.oplus.camera.unit.sdk",
    jars: ["proprietary/framework/com.oplus.camera.unit.sdk.jar"],
    system_ext_specific: true,
}

dex_import {
    name: "com.oplus.camera.unit.sdk.adapter",
    jars: ["proprietary/framework/com.oplus.camera.unit.sdk.adapter.jar"],
    system_ext_specific: true,
}

// ro.hardware.camera=oemlayer.v2 selects this wrapper before the Qualcomm HAL.
// It populates the OEM camera characteristics required by the stock camera SDK.
cc_prebuilt_library_shared {
    name: "lafa-camera-oemlayer",
    stem: "camera.oemlayer.v2",
    device_specific: true,
    relative_install_path: "hw",
    compile_multilib: "64",
    srcs: ["proprietary/lib64/camera.oemlayer.v2.so"],
    strip: { none: true },
    check_elf_files: false,
}

// Both APS and OplusStringJNI load this from the ODM/SP-HAL namespace.
cc_prebuilt_library_shared {
    name: "lafa-camera-libOplusSecurity",
    stem: "libOplusSecurity",
    device_specific: true,
    compile_multilib: "64",
    srcs: ["proprietary/lib64/libOplusSecurity.so"],
    strip: { none: true },
    check_elf_files: false,
}

// Selected by the existing shared-platform module when this port is enabled.
// Keep a single libsensorbridge provider for the HAL and its dependent libraries.
filegroup {
    name: "lafa-camera-sensorbridge-blob",
    srcs: ["proprietary/lib64/libsensorbridge.so"],
    visibility: ["//vendor/oneplus/sm8850-common:__pkg__"],
}

